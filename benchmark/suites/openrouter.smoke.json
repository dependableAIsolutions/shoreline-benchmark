{
  "name": "openrouter-sota-quick",
  "adapter": "openrouter",
  "categories": ["mult", "modexp", "bool", "matrix", "combo", "random", "constrained", "sudoku", "distrib", "selfref", "counting"],
  "trialsPerDifficulty": 1,
  "probeTrials": 1,
  "quickMode": true,
  "temperature": 0.7,
  "outputRoot": "results",
  "staticOutput": "apps/web/src/data",
  "skipCompleted": true,
  "resumeIncomplete": true,
  "continueOnError": true,
  "openrouter": {
    "apiKeyEnv": "OPENROUTER_API_KEY"
  },
  "models": [
    {
      "id": "google/gemini-3-flash-preview",
      "enabled": true,
      "notes": "Google Gemini 3 Flash Preview"
    },
    {
      "id": "moonshotai/kimi-k2.5",
      "enabled": true,
      "notes": "Moonshot Kimi K2.5"
    },
    {
      "id": "deepseek/deepseek-v3.2",
      "enabled": true,
      "notes": "DeepSeek V3.2"
    },
    {
      "id": "minimax/minimax-m2.1",
      "enabled": true,
      "notes": "MiniMax M2.1"
    },
    {
      "id": "x-ai/grok-4.1-fast",
      "enabled": true,
      "notes": "xAI Grok 4.1 Fast"
    },
    {
      "id": "openai/gpt-oss-120b",
      "enabled": true,
      "notes": "OpenAI GPT OSS 120B"
    }
  ]
}
