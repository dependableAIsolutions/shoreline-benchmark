{
  "name": "openrouter-sota-quick",
  "adapter": "openrouter",
  "categories": ["mult", "modexp", "bool", "matrix", "combo", "random", "constrained", "sudoku", "distrib", "selfref", "counting"],
  "trialsPerDifficulty": 1,
  "probeTrials": 1,
  "quickMode": true,
  "temperature": 0.7,
  "outputRoot": "results",
  "staticOutput": "apps/web/src/data",
  "skipCompleted": true,
  "resumeIncomplete": true,
  "continueOnError": true,
  "openrouter": {
    "apiKeyEnv": "OPENROUTER_API_KEY"
  },
  "models": [
    {
      "id": "openai/gpt-5.2",
      "enabled": true,
      "notes": "SOTA reasoning baseline"
    },
    {
      "id": "anthropic/claude-sonnet-4.5",
      "enabled": true,
      "notes": "SOTA production reasoning"
    },
    {
      "id": "google/gemini-2.5-pro",
      "enabled": true,
      "notes": "SOTA multimodal reasoning"
    }
  ]
}
