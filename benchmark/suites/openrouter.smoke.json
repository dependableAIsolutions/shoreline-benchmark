{
  "name": "openrouter-smoke",
  "adapter": "openrouter",
  "categories": ["mult"],
  "trialsPerDifficulty": 1,
  "probeTrials": 1,
  "quickMode": true,
  "temperature": 0.7,
  "outputRoot": "results",
  "staticOutput": "apps/web/src/data",
  "skipCompleted": true,
  "resumeIncomplete": true,
  "continueOnError": true,
  "openrouter": {
    "apiKeyEnv": "OPENROUTER_API_KEY"
  },
  "models": [
    {
      "id": "openai/gpt-4o-mini",
      "enabled": true,
      "notes": "Cheap smoke-test model"
    }
  ]
}
