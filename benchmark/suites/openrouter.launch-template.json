{
  "name": "openrouter-sota-launch-template",
  "adapter": "openrouter",
  "categories": ["mult", "modexp", "bool", "matrix", "combo", "random", "constrained", "sudoku", "distrib", "selfref", "counting"],
  "trialsPerDifficulty": 20,
  "probeTrials": 3,
  "quickMode": false,
  "temperature": 0.7,
  "outputRoot": "results",
  "staticOutput": "apps/web/src/data",
  "skipCompleted": true,
  "resumeIncomplete": true,
  "continueOnError": true,
  "openrouter": {
    "apiKeyEnv": "OPENROUTER_API_KEY"
  },
  "models": [
    { "id": "openai/gpt-5.2-pro", "enabled": false, "notes": "Frontier OpenAI model" },
    { "id": "openai/o3-pro", "enabled": false, "notes": "Frontier OpenAI reasoning model" },
    { "id": "anthropic/claude-opus-4.6", "enabled": false, "notes": "Frontier Anthropic model" },
    { "id": "anthropic/claude-sonnet-4.5", "enabled": false, "notes": "High-end Anthropic model" },
    { "id": "google/gemini-2.5-pro", "enabled": false, "notes": "Top Gemini model" },
    { "id": "x-ai/grok-4", "enabled": false, "notes": "Top xAI model" },
    { "id": "meta-llama/llama-4-maverick", "enabled": false, "notes": "Top open-weights contender" },
    { "id": "deepseek/deepseek-r1", "enabled": false, "notes": "Top reasoning-specialized model" }
  ]
}
