{
  "name": "shoreline-benchmark",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "benchmark:suite": "tsx scripts/run-benchmark-suite.ts",
    "recompute-scores": "tsx scripts/recompute-scores.ts",
    "generate-static": "tsx scripts/generate-static.ts",
    "deploy:hosting": "./deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
