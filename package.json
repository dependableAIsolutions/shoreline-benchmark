{
  "name": "shoreline-benchmark",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "benchmark:suite": "tsx scripts/run-benchmark-suite.ts",
    "recompute-scores": "tsx scripts/recompute-scores.ts",
    "generate-static": "tsx scripts/generate-static.ts",
    "deploy:hosting": "./deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.0",
      "rollup": "^4.59.0",
      "vite": "^7.3.5",
      "anymatch>picomatch": "^2.3.2",
      "tinyglobby>picomatch": "^4.0.4",
      "readdirp>picomatch": "^2.3.2",
      "vitest>picomatch": "^4.0.4",
      "yaml": "^2.8.3",
      "micromatch>picomatch": "^2.3.2"
    }
  }
}
