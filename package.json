{
  "name": "shoreline-benchmark",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "benchmark:suite": "tsx scripts/run-benchmark-suite.ts",
    "recompute-scores": "tsx scripts/recompute-scores.ts",
    "generate-static": "tsx scripts/generate-static.ts",
    "deploy:hosting": "./deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.4",
      "rollup": "^4.59.0",
      "vite": "^7.3.5",
      "anymatch>picomatch": "^2.3.2",
      "tinyglobby>picomatch": "^4.0.4",
      "readdirp>picomatch": "^2.3.2",
      "vitest>picomatch": "^4.0.4",
      "yaml": "^2.8.3",
      "micromatch>picomatch": "^2.3.2",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.3",
      "browserslist@<=4.28.6": "4.28.7",
      "fflate@>=0.8.0 <0.8.3": "0.8.3",
      "fflate@>=0.6.0 <0.6.11": "0.6.11",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0"
    }
  }
}
